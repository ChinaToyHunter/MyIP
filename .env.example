# Server
BACKEND_PORT="11966"
FRONTEND_PORT="18966"
# Comma-separated IPs/subnets for every trusted reverse-proxy hop when traffic
# does not arrive through the bundled loopback frontend proxy. Empty defaults
# to exactly one loopback hop. Use exact addresses/ranges from nearest to
# furthest infrastructure; never trust all proxies on a public backend.
TRUST_PROXY=""
ALLOWED_DOMAINS=""
# THIRD-PARTY APIs
GOOGLE_MAP_API_KEY=""
IPINFO_API_KEY=""
CLOUDFLARE_API_KEY=""
IPAPIIS_API_KEY=""
IP2LOCATION_API_KEY=""
MAC_LOOKUP_API_KEY=""
RIPESTAT_SOURCE_APP=""
# Shareable diagnostic reports — stored in Cloudflare Workers KV. Both values
# below must be set (together with CLOUDFLARE_API_KEY, which additionally
# needs the "Workers KV Storage: Edit" permission) or the share-link feature
# stays hidden. CLOUDFLARE_KV_NAMESPACE_ID is the namespace's hex ID from the
# dashboard, not its name.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_KV_NAMESPACE_ID=""
# MaxMind
MAXMIND_ACCOUNT_ID=""
MAXMIND_LICENSE_KEY=""
MAXMIND_AUTO_UPDATE="false"
# CAIDA
CAIDA_AUTO_UPDATE="false"
# SITE
VITE_SITE_URL="https://ipcheck.ing"
# DOCS SITE — origin of the GitBook docs site powering the in-app
# assistant and the Help Center link. Empty disables both.
VITE_DOCS_URL=""
# EARTH ONLINE — full URL of the pulse backend (trailing slashes stripped).
# Empty hides the social parts (status feed / visitor map / visit beacon) at
# build time, like Sentry. The outage feed is independent — it only needs
# CLOUDFLARE_API_KEY above.
VITE_PULSE_BEACON_URL=""
# CURL API
VITE_CURL_IPV4_DOMAIN=""
VITE_CURL_IPV6_DOMAIN=""
VITE_CURL_IPV64_DOMAIN=""
# Google Analytics
VITE_GOOGLE_ANALYTICS_ID=""
# Security related
# SECURITY_BLACKLIST_LOG_FILE_PATH: opt-in on-disk ledger of rate-limited IPs
# (e.g. "logs/blacklist-ip.log"). Empty = no file; the event is always logged
# via the shared logger either way (and mirrored to Sentry when configured).
SECURITY_BLACKLIST_LOG_FILE_PATH=""
SECURITY_RATE_LIMIT=""
SECURITY_DELAY_AFTER=""
# Sentry — all optional; leave empty and no Sentry code ships or runs at all.
# VITE_SENTRY_DSN_FRONTEND: frontend DSN (build-time; baked into the bundle;
#   also read by the backend at runtime as the allowlist for /api/monitoring,
#   the first-party tunnel that relays envelopes past ad blockers)
# SENTRY_DSN_BACKEND: backend DSN (runtime; read by sentry-instrument.js)
# SENTRY_ENVIRONMENT: backend environment tag — unset means "production",
#   set "development" on dev machines (frontend tags itself automatically)
# SENTRY_ORG / SENTRY_PROJECT_FRONTEND / SENTRY_AUTH_TOKEN: source-map upload
# at build time only — the token is a secret, never exposed to the browser
VITE_SENTRY_DSN_FRONTEND=""
SENTRY_DSN_BACKEND=""
SENTRY_ENVIRONMENT=""
SENTRY_ORG=""
SENTRY_PROJECT_FRONTEND=""
SENTRY_AUTH_TOKEN=""
# Logging — LOG_LEVEL: debug/info/warn/error (default info)
#           LOG_FORMAT: "json" for log shippers, anything else = pretty
#           LOG_HTTP: "true" to enable per-request /api logging (off by default)
LOG_LEVEL=""
LOG_FORMAT=""
LOG_HTTP=""
# Unified v1 API (fork addition)
UNIFIED_API_KEYS=""                # comma-separated static keys for gated /api/v1 routes
V1_ANON_RATE_LIMIT_PER_MIN=60
V1_KEY_RATE_LIMIT_PER_MIN=300
# Shared request budget in milliseconds; invalid values fall back to 8000.
# Accepted range: 100–30000.
UNIFIED_LOOKUP_DEADLINE_MS=8000
# Quality providers. Comma-separated pools are supported; an unset key drops
# that source from the response and records an api_key_missing entry in
# lookup.errors[] / errors[] instead of failing the request.
# IP2LOCATION_API_KEY is the same key the legacy /api/ip2location route reads.
ABUSEIPDB_API_KEY=""
IPQS_API_KEY=""
IPDATA_API_KEY=""
# Two sources serve the anonymous self lookup (GET /api/v1/ip) and nothing
# else, and both are off until switched on here — key presence alone is not
# enough. Enable them once the deployment shape is known to suit them:
#   V1_IPPURE_ENABLED       — IPPure is keyless and answers about the direct
#     connection peer. Behind a reverse proxy whose visitor IP lives only in
#     forwarding headers, it degrades to measuring this deployment's own
#     egress; a subject mismatch is dropped with a 422 errors[] entry.
#   V1_IPGEOLOCATION_ENABLED — also needs IPGEOLOCATION_API_KEY. Its threat
#     fields need a paid plan; on a free plan it still contributes ASN/company
#     with the security block null (a 5xx or 429 is reported as a failure
#     rather than mistaken for a plan gate).
V1_IPPURE_ENABLED="false"
V1_IPGEOLOCATION_ENABLED="false"
IPGEOLOCATION_API_KEY=""
# Egress probe (fork addition) — measures THIS deployment's outbound address,
# using IPQuality (AGPL-3.0, github.com/xykt/IPQuality) in its own container
# built from ipquality-sidecar/. No lookup source can answer this: those
# describe an address you ask about, this describes the machine doing the
# asking.
#   IPQUALITY_SIDECAR_URL — base URL of that container; empty leaves the route
#     mounted but answering 503. Under docker compose this is the service name
#     (http://ipquality-sidecar:8080) — the sidecar publishes no host port.
#   IPQUALITY_SIDECAR_TOKEN — shared secret, sent as X-Probe-Token. The sidecar
#     needs the same value as its PROBE_TOKEN (docker-compose.yml feeds one
#     variable to both). Empty means no token is required, which is only
#     acceptable while the sidecar stays on an internal network: its /latest
#     hands out this deployment's egress address.
#   V1_PROBE_CACHE_TTL_SEC — how long a report stays fresh. Long on purpose: a
#     run takes 30-90s and contacts hundreds of third-party endpoints. A read
#     past the TTL is served at once with stale:true while a refresh runs behind
#     it.
#   V1_PROBE_TIMEOUT_MS — ceiling for one sidecar call, above the sidecar's own
#     deadline (PROBE_HARD_TIMEOUT plus its backstop, ~110s) so that a merely
#     slow probe is not cut off here.
#   V1_PROBE_RATE_LIMIT_PER_HOUR — additional cap on this route alone, on top of
#     the per-minute limiter above.
IPQUALITY_SIDECAR_URL=""
IPQUALITY_SIDECAR_TOKEN=""
V1_PROBE_CACHE_TTL_SEC=600
V1_PROBE_TIMEOUT_MS=120000
V1_PROBE_RATE_LIMIT_PER_HOUR=6
